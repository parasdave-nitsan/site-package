{
    "name": "company/my-site-package",
    "type": "typo3-cms-extension",
    "description": "Company Website Package - Image Slider, FAQ and Contact Form Components",
    "homepage": "https://homepage.com",
    "license": ["GPL-2.0-or-later"],
    "keywords": ["TYPO3 CMS"],
    "version": "1.0.0",
    "authors": [
        {
            "name": "John Doe",
            "email": "john.doe@gmail.com",
            "homepage": "https://homepage.com"
        }
    ],
    "require": {
        "typo3/cms-core": "^14.0",
        "typo3/cms-rte-ckeditor": "^14.0",
        "typo3/cms-fluid-styled-content": "^14.0"
    },
    "suggest": {
        "friendsoftypo3/content-blocks": "Allows to create custom content elements. "
    },
    "autoload": {
        "psr-4": {
            "Company\\MySitePackage\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "Website starter kit",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
